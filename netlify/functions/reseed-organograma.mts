export default async (req: Request) => {
  if (req.method !== "POST") return new Response("method not allowed", { status: 405 });
  const db = getDatabase();
  try {
    const body = await req.json().catch(() => ({}));
    if (body.confirm !== "RESETAR_E_IMPORTAR_ORGANOGRAMA") {
      return new Response("confirmacao ausente ou incorreta", { status: 400 });
    }

    // 1) limpa tudo que depende de roles (cascade cuida de employees/criteria/evaluations/succession/highlights)
    await db.sql`DELETE FROM roles`;

    // 2) cria as funcoes
    const roleIdByCargo: Record<string, string> = {};
    for (const r of ROLES) {
      const [row]: any[] = await db.sql`
        INSERT INTO roles (name, area, notes, critical)
        VALUES (${r.cargo}, ${r.area}, ${r.notes}, ${r.critical})
        RETURNING id
      `;
      roleIdByCargo[r.cargo] = row.id;
    }

    // 3) cria os colaboradores (sem lider ainda)
    const employeeIdByName: Record<string, string> = {};
    for (const e of EMPLOYEES) {
      const roleId = roleIdByCargo[e.cargo];
      const [row]: any[] = await db.sql`
        INSERT INTO employees (role_id, name, status, salary)
        VALUES (${roleId}, ${e.nome}, 'ativo', ${e.salario})
        RETURNING id
      `;
      employeeIdByName[e.nome] = row.id;
    }

    // 4) resolve lideranca (nomes -> id)
    let leadersSet = 0;
    for (const e of EMPLOYEES) {
      if (e.leaderName && employeeIdByName[e.leaderName]) {
        await db.sql`UPDATE employees SET leader_id = ${employeeIdByName[e.leaderName]} WHERE id = ${employeeIdByName[e.nome]}`;
        leadersSet++;
      }
    }

    // 5) cria os criterios (universais + de escopo) por funcao
    let criteriaCount = 0;
    for (const r of ROLES) {
      const roleId = roleIdByCargo[r.cargo];
      for (const c of UNIVERSAL_CRITERIA) {
        await db.sql`
          INSERT INTO criteria (role_id, name, category, type, weight, description)
          VALUES (${roleId}, ${c.name}, ${c.category}, ${c.type}, ${c.weight}, ${c.desc})
        `;
        criteriaCount++;
      }
      for (const c of r.scopeCriteria) {
        await db.sql`
          INSERT INTO criteria (role_id, name, category, type, weight, description)
          VALUES (${roleId}, ${c.name}, ${c.category}, ${c.type}, ${c.weight}, ${c.desc})
        `;
        criteriaCount++;
      }
    }

    return Response.json({
      ok: true,
      roles: ROLES.length,
      employees: EMPLOYEES.length,
      leadersSet,
      criteria: criteriaCount,
    });
  } catch (err: any) {
    return new Response(String(err && err.message ? err.message : err), { status: 500 });
  }
};

